{
  "name": "campusmesh-monorepo",
  "version": "1.0.5",
  "private": true,
  "description": "Decentralized, zero-cost, cross-platform P2P communication platform",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @campusmesh/web dev",
    "build": "pnpm --recursive run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm --recursive run typecheck",
    "format:check": "prettier --check \"**/*.{ts,js,vue,json,md,yaml,yml}\"",
    "format": "prettier --write \"**/*.{ts,js,vue,json,md,yaml,yml}\"",
    "clean": "pnpm --recursive run clean"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^22.9.0",
    "eslint": "^9.14.0",
    "eslint-plugin-vue": "^9.30.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
